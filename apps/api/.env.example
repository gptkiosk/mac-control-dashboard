# Copy to ~/.mac-control/.env (mode 600). Replace every placeholder; never commit real values.
MAC_CONTROL_PORT=<PORT>
MAC_CONTROL_HOST=<LOOPBACK_HOST>
MAC_CONTROL_LOG_LEVEL=<LOG_LEVEL>
MAC_CONTROL_ORGANIZATION_NAME=<ORGANIZATION_NAME>
MAC_CONTROL_PRODUCT_NAME=<PRODUCT_NAME>
MAC_CONTROL_PRODUCT_SHORT_NAME=<PRODUCT_SHORT_NAME>

# Read-only sources use the existing gh login; no token is needed here.
MAC_CONTROL_GH_PATH=<PATH_TO_GH>
MAC_CONTROL_OPS_REPORTS_DIR=<PATH_TO_REPORTS_DIRECTORY>
